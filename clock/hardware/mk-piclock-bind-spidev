#!/bin/bash
set -euo pipefail

DEVICE=spi0.0
SYSDEV=/sys/bus/spi/devices/${DEVICE}
DRIVER=/sys/bus/spi/drivers/spidev

modprobe spidev

for _ in $(seq 1 100); do
    [ -e "$SYSDEV" ] && break
    sleep 0.1
done

[ -e "$SYSDEV" ] || {
    echo "ERROR: ${DEVICE} was not created by the active Device Tree." >&2
    exit 1
}

if [ -L "$SYSDEV/driver" ] && [ "$(basename "$(readlink -f "$SYSDEV/driver")")" = "spidev" ]; then
    exit 0
fi

printf '%s\n' spidev > "$SYSDEV/driver_override"
printf '%s\n' "$DEVICE" > "$DRIVER/bind"

for _ in $(seq 1 50); do
    [ -e /dev/spidev0.0 ] && exit 0
    sleep 0.1
done

echo "ERROR: /dev/spidev0.0 was not created." >&2
exit 1
