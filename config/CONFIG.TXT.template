# bpi-zero-wbuild configuration
# Edit on Windows, macOS or Linux, save, then boot the board.
#
# SSID     Wi-Fi network name
# PSK      WPA/WPA2/WPA3 passphrase, 8-63 characters
# COUNTRY  two-letter country code, e.g. CA or US
# HIDDEN   true or false
# TIMEZONE IANA timezone name
# ROOT_PASSWORD password for the only login account (root), 8-64 characters
#
# SECURITY: after successful firstboot, PSK= and ROOT_PASSWORD= are automatically
# blanked on this FAT32 partition. The installed iwd profile remains root-only.
#
# Common timezone examples:
# America/Edmonton, America/Vancouver, America/Winnipeg, America/Toronto,
# America/Halifax, America/St_Johns, America/Los_Angeles, America/Denver,
# America/Chicago, America/New_York, America/Phoenix, America/Anchorage,
# Pacific/Honolulu, UTC

SSID=
PSK=
COUNTRY=CA
HIDDEN=false
TIMEZONE=America/Edmonton
ROOT_PASSWORD=
